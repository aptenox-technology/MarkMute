# ---- App ----
APP_NAME="MarkMute"
DEBUG=false
HOST=0.0.0.0
PORT=8000
MAX_FILE_SIZE=268435456
MAX_INPUT_SIZE=268435456
UPLOAD_DIR=./uploads

# ---- Redis / Celery (required only for async pixel-removal / rewrite jobs) ----
REDIS_URL=redis://localhost:6379/0

# ---- Optional external tools ----
EXIFTOOL_PATH=/usr/bin/exiftool
C2PATOOL_PATH=/usr/local/bin/c2patool

# ---- Optional: SynthID scoring (path to checkout) ----
REVERSE_SYNTHID_DIR=/opt/reverse-SynthID

# ---- Optional: CtrlRegen pixel removal (path to checkout) ----
NOAI_WATERMARK_DIR=/opt/noai-watermark

# ---- Optional: rewrite backends ----
# OpenAI-compatible backend reads WATERMARKS_REWRITE_API_KEY / MODEL / BASE_URL.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
WATERMARKS_REWRITE_ALLOW_REMOTE=0
WATERMARKS_REWRITE_API_KEY=
WATERMARKS_REWRITE_MODEL=
WATERMARKS_REWRITE_BASE_URL=

# ---- Security ----
CORS_ORIGINS=http://localhost:8000
