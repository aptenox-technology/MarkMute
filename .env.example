# Copy to .env and adjust. All variables are optional; defaults are sane.

# --- App ---
# APP_NAME=MarkMute
# DEBUG=false
# HOST=0.0.0.0
# PORT=8000
# CORS_ORIGINS=https://markmute.vercel.app,http://localhost:8000

# --- Storage ---
# UPLOAD_DIR=./uploads

# --- Limits ---
# MAX_FILE_SIZE=268435456
# MAX_INPUT_SIZE=268435456

# --- Redis / Celery (async pixel removal only) ---
# REDIS_URL=redis://localhost:6379/0

# --- External binaries (paths on the host) ---
# EXIFTOOL_PATH=/usr/bin/exiftool
# C2PATOOL_PATH=/usr/local/bin/c2patool

# --- Optional: SynthID scoring checkout ---
# REVERSE_SYNTHID_DIR=/path/to/reverse-synthid

# --- Optional: CtrlRegen pixel removal checkout (needs GPU) ---
# NOAI_WATERMARK_DIR=/path/to/noai-watermark

# --- Optional: LLM rewrite backends ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
# WATERMARKS_REWRITE_ALLOW_REMOTE=0
# WATERMARKS_REWRITE_API_KEY=
# WATERMARKS_REWRITE_MODEL=
# WATERMARKS_REWRITE_BASE_URL=
